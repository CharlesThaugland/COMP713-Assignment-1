<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ConsoleDex</title>
</head>
<body>

    <h1>== CONSOLEDEX ==</h1>
    <button onclick="window.location.href='/home/add'">
        Add a Console
    </button>
    
    <br>
    <h3>Current Consoles:</h3>
    <% consoles.forEach(function(console){ %>

        <div class="console">
            <h2><%= console.name %></h2>
            <p>Condition: <%= console.condition %></p>
            <p>Value: <%= console.value %></p>
            <p>Model Number: <%= console.model_no %></p>
            <p>Region: <%= console.region %></p>
            <p>Description: <%= console.notes %></p>
        </div>
    <% }); %>
</body>
</html>