<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ConsoleDex</title>
</head>
<body>

    <h1>== CONSOLEDEX ==</h1>
    <button onclick="window.location.href='/home/add'">
        Add a Console
    </button>
    
    <br>
    <h3>Current Consoles:</h3>
    <% consoles.forEach(function(console){ %>

        <div class="console">
            <h2><%= console.name %></h2>
            <p>Condition: <%= console.console_condition %></p>
            <p>Value: <%= console.value %></p>
            <p>Model Number: <%= console.model_no %></p>
            <p>Description: <%= console.notes %></p>

            <!--view the full console detials and accessories-->
            <form action="/home/viewconsole" method="GET">
                <input type="hidden" name="console_id" value="<%= console.console_id %>"> 
                <button type="submit">View Full Console Details and Accessories</button>
            </form>

        </div>
    <% }); %>
</body>
</html>